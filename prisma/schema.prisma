generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ShippingStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InventoryMovementType {
  CREATED
  ADJUSTMENT
  ORDER_DEDUCTION
}

enum QuoteStatus {
  NEW
  CONTACTED
  CLOSED
}

enum Division {
  Cauchos
  Import
  Innovation
  Energy
  Plastic
}

model Product {
  id                    String              @id @default(cuid())
  slug                  String              @unique
  sku                   String?             @unique
  oemReference          String?
  alternativeReferences String[]            @default([])
  category              String
  name                  String
  brand                 String
  division              Division            @default(Cauchos)
  additionalDivisions   Division[]          @default([])
  price                 Int
  previousPrice         Int
  displayPriceOverride  String?
  displaySecondaryLabel String?
  stock                 Int                 @default(12)
  minimumStock          Int                 @default(3)
  image                 String
  galleryImages         String[]            @default([])
  availability          String
  description           String
  application           String?
  compatibility         String[]            @default([])
  warranty              String?
  technicalSheetUrl     String?
  technicalSpecs        Json?
  featured              Boolean             @default(false)
  active                Boolean             @default(true)
  inventoryMovements    InventoryMovement[]
  variants              ProductVariant[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  label              String
  sku                String              @unique
  price              Int?
  stock              Int                 @default(0)
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  company      String?
  email        String     @unique
  phone        String?
  department   String?
  city         String?
  addressLine1 String?
  addressLine2 String?
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  division     Division?
  permissions  String[]   @default([])
  active       Boolean    @default(true)
  cartItems    CartItem[]
  orders       Order[]
  quotes       Quote[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CartItem {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  variantSku   String   @default("")
  variantLabel String   @default("")
  name         String
  price        String
  image        String
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, productId, variantSku])
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    Int            @unique @default(autoincrement())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         OrderStatus    @default(PENDING)
  paymentStatus  PaymentStatus  @default(PENDING)
  shippingStatus ShippingStatus @default(PENDING)
  division       Division       @default(Cauchos)
  customerName   String
  customerEmail  String
  customerPhone  String
  company        String?
  department     String
  city           String
  addressLine1   String
  addressLine2   String?
  notes          String?
  carrier        String?
  trackingNumber String?
  adminNotes     String?
  preparingAt    DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  subtotal       Int
  shippingCost   Int            @default(0)
  totalItems     Int
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  variantSku   String?
  variantLabel String?
  division     Division @default(Cauchos)
  name         String
  image        String
  unitPrice    Int
  quantity     Int
  lineTotal    Int
  createdAt    DateTime @default(now())
}

model InventoryMovement {
  id               String                @id @default(cuid())
  productId        String
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId String?
  productVariant   ProductVariant?       @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  type             InventoryMovementType
  quantity         Int
  stockAfter       Int
  note             String?
  createdAt        DateTime              @default(now())
}

model SiteImage {
  key       String   @id
  url       String
  link      String?
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Pending, unpublished edits to SiteImage/SiteSetting content. The live site
// only ever reads SiteImage/SiteSetting directly — this table never touches
// production rendering. A row here means "this key has an unpublished
// change"; publishing copies it into the live table and deletes the draft.
model SiteContentDraft {
  key       String   @id
  kind      String
  division  String
  value     String
  link      String?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Snapshot of the full live SiteImage/SiteSetting content, taken right
// before every publish (and before every restore, as a safety net), so an
// admin can see history and roll back.
model SiteContentVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  createdBy String?
  division  String
  label     String?
  snapshot  Json
}

model Quote {
  id                  String      @id @default(cuid())
  userId              String?
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName            String
  company             String
  nit                 String
  phone               String
  division            Division
  requestType         String
  productDetails      String
  process             String[]
  conditions          String[]
  quantityAndDeadline String
  details             Json?
  adminNotes          String?
  status              QuoteStatus @default(NEW)
  createdAt           DateTime    @default(now())
}
